# 模型连接配置：替换成你自己的 USTC 服务信息。
USTC_API_KEY=your_api_key_here
USTC_BASE_URL=https://your-provider.example/v1
USTC_MODEL=your_tool_capable_model_id

# 可选网页搜索：填写独立的 Tavily 密钥后，终端和微信启用 web_search。
# 留空则不启用搜索，不影响模型聊天；不要填写 USTC 的密钥。
TAVILY_API_KEY=

# 是否显示工具名称、参数和结果日志；操作确认仍会显示。
ZIPCLAW_SHOW_TOOL_LOGS=false

# 是否显示服务端返回的推理文本；不控制模型是否开启思考模式。
ZIPCLAW_SHOW_REASONING=true

# 思考模式：同时作用于普通摘要请求和流式聊天请求。
# default 不传 thinking 参数，使用服务端默认行为，不代表关闭思考。
# enabled / disabled 仅适用于支持这种 thinking 参数格式的接口。
ZIPCLAW_THINKING_MODE=default

# 仅微信入口：true 免确认执行工具，并允许文件工具访问工作区外的路径。
# false 保留操作确认和工作区边界；不会改变终端入口的行为。
ZIPCLAW_WECHAT_FULL_ACCESS=false

# 每次用户任务最多执行的普通模型请求轮数，必须是正整数。
ZIPCLAW_MAX_STEPS=10

# 上下文压缩触发阈值，单位是 JSON 字符，必须是正整数。
ZIPCLAW_CONTEXT_CHAR_BUDGET=60000

#上下文压缩时保留的用户交互轮数
ZIPCLAW_KEEP_RECENT_TURNS=8
